    {
      "id": "mvx-ide-taurus",
      "name": "MVX IDE TAURUS",
      "category": "IDE / DEUF",
      "paths": [
        "mvx-ide-taurus",
        "MVX-IDE-Taurus"
      ],
      "repo": "lucadeg/MVX-IDE-Taurus",
      "modes": {
        "dev": {
          "kind": "npm",
          "script": "dev",
          "port": 1420,
          "auth": "browser-local-development-only"
        },
        "production": {
          "kind": "binary",
          "relative": "target/release/mvx-ide-taurus.exe",
          "auth": "native-keycloak",
          "requiredEnv": [
            "MVX_KEYCLOAK_ISSUER",
            "MVX_KEYCLOAK_CLIENT_ID"
          ]
        }
      }
    },
